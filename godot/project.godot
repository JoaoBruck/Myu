; Engine configuration file.
; MYU — Godot outdoor lab
config_version=5

[application]
config/name="MYU — Godot Outdoor Lab"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7")

[display]
window/size/viewport_width=512
window/size/viewport_height=288
window/size/window_width_override=1024
window/size/window_height_override=576
window/stretch/mode="canvas_items"

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0.039, 0.043, 0.067, 1)
